{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "メインウィンドウの権限。ファイルは createFileStorage の保存先（$APPDATA/projects）と、ダイアログで選んだファイルとフォルダの直下だけを読み書きできる",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "store:default",
    "fs:read-all",
    "fs:write-all",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$APPDATA/projects" }, { "path": "$APPDATA/projects/**" }]
    }
  ]
}
