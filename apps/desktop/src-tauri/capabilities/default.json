{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "メインウィンドウと脚本のウィンドウ（desktop/windows.ts の scriptWindowLabel）の権限。どちらも同じアプリを載せるので同じ権限にする。ファイルは createFileStorage の保存先（$APPDATA/projects）と、ダイアログで選んだファイルだけを読み書きできる",
  "windows": ["main", "script-*"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-set-focus",
    "dialog:default",
    "store:default",
    "fs:read-all",
    "fs:write-all",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$APPDATA/projects" }, { "path": "$APPDATA/projects/**" }]
    }
  ]
}
