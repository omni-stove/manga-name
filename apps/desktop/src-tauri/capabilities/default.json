{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "メインウィンドウの権限。ファイルは createFileStorage の保存先（$APPDATA/projects）と、ダイアログで選んだファイルとフォルダの直下と、ウィンドウに落としたファイル（plugin-fs が実行時に足す）だけを読み書きできる。deep link を受けたらウィンドウを前に出す",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-focus",
    "dialog:default",
    "deep-link:default",
    "notification:default",
    "opener:default",
    "store:default",
    "fs:read-all",
    "fs:write-all",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$APPDATA/projects"
        },
        {
          "path": "$APPDATA/projects/**"
        }
      ]
    }
  ]
}
