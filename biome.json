{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!fixtures",
      "!**/dist",
      "!**/dist-collab",
      "!**/target",
      "!pnpm-lock.yaml",
      "!**/routeTree.gen.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error",
        "useReactCompiler": "error"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/**", "!packages/inspector/**", "!packages/editor-canvas/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@manga/**",
                      "!@manga/schema",
                      "!@manga/i18n",
                      "!@manga/schema/**",
                      "!@manga/i18n/**"
                    ],
                    "message": "packages/* 同士の連携は apps/web が配線する（CONTRIBUTING.md の規約）"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/inspector/**", "packages/editor-canvas/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@manga/**",
                      "!@manga/schema",
                      "!@manga/i18n",
                      "!@manga/ui",
                      "!@manga/schema/**",
                      "!@manga/i18n/**",
                      "!@manga/ui/**"
                    ],
                    "message": "packages/* 同士の連携は apps/web が配線する（CONTRIBUTING.md の規約）"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
