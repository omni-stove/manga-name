{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["biome", "mise", "tauri-driver"],
  "workspaces": {
    ".": {
      "entry": [".agents/skills/*/scripts/*.ts"]
    },
    "packages/render": {
      "entry": ["src/backend-node.ts"]
    },
    "apps/web": {
      "entry": [
        "src/store/project-store.ts",
        "src/store/yjs-project-store.ts",
        "src/routeTree.gen.ts"
      ]
    },
    "packages/i18n": {
      "ignoreDependencies": ["@inlang/plugin-message-format"]
    },
    "workers/api": {
      "entry": ["src/rpc.ts"],
      "ignoreDependencies": ["cloudflare"]
    },
    "apps/cli": {
      "entry": ["src/main.ts"]
    }
  }
}
