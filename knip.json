{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["biome", "mise", "tauri-driver"],
  "workspaces": {
    "packages/render": {
      "entry": ["src/backend-node.ts"]
    },
    "apps/web": {
      "entry": ["src/store/project-store.ts", "src/store/yjs-project-store.ts"]
    },
    "packages/i18n": {
      "ignoreDependencies": ["@inlang/plugin-message-format"]
    },
    "workers/api": {
      "entry": ["src/rpc.ts"],
      "ignoreDependencies": ["cloudflare"]
    }
  }
}
