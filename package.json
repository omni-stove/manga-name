{
  "name": "manga",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit && pnpm -r --parallel --aggregate-output run typecheck",
    "test": "vitest run && pnpm --filter \"./workers/*\" test",
    "test:watch": "vitest",
    "check": "mise run check"
  },
  "devDependencies": {
    "knip": "^6.41.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "catalog:"
  }
}
