{
  "$schema": "https://inlang.com/schema/project-settings",
  "baseLocale": "ja",
  "locales": ["ja"],
  "modules": ["./node_modules/@inlang/plugin-message-format/dist/index.js"],
  "plugin.inlang.messageFormat": {
    "pathPattern": [
      "./messages/api/{locale}.json",
      "./messages/web/{locale}.json",
      "./messages/ui/{locale}.json",
      "./messages/inspector/{locale}.json",
      "./messages/editor-canvas/{locale}.json",
      "./messages/storage/{locale}.json",
      "./messages/schema/{locale}.json",
      "./messages/common/{locale}.json"
    ]
  }
}
