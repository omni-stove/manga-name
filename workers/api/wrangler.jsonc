{
  "name": "manga-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "manga-api",
      "database_id": "local",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "ASSETS", "bucket_name": "manga-assets" }],
  "vars": {
    "WEB_ORIGINS": "http://localhost:5173",
    // 06-open-questions.md #9 が決まるまでの仮の値
    "MONTHLY_GENERATION_LIMIT": "300"
  }
  // 秘密: wrangler secret put APP_ACCESS_TOKEN と ASSET_URL_SECRET（実プロバイダを足すときはその API キーも）
}
