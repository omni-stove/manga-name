{
  "name": "manga-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "manga-api",
      "database_id": "local",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "PROJECT_ROOMS", "class_name": "ProjectRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProjectRoom"] }],
  "images": { "binding": "IMAGES" },
  "r2_buckets": [{ "binding": "ASSETS", "bucket_name": "manga-assets" }],
  "vars": {
    // env なしの deploy でも X-Debug-User が開かないよう、既定は閉じた値にする。development は wrangler dev の --var とテストの bindings で明示する
    "ENVIRONMENT": "production",
    "WEB_ORIGINS": "http://localhost:5173",
    // 06-open-questions.md #9 が決まるまでの仮の値
    "MONTHLY_GENERATION_LIMIT": "300"
  },
  // 秘密: wrangler secret put BETTER_AUTH_SECRET、GOOGLE_CLIENT_ID、GOOGLE_CLIENT_SECRET、ASSET_URL_SECRET、GEMINI_API_KEY、ANTHROPIC_API_KEY（staging は --env staging）
  "env": {
    // bindings と vars は env に継承されないので、トップレベルと同じものを staging のリソースで書き直す
    "staging": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "manga-api-staging",
          "database_id": "12b85aa8-23f8-41ae-942d-e4b5cc44c125",
          "migrations_dir": "migrations"
        }
      ],
      "durable_objects": {
        "bindings": [{ "name": "PROJECT_ROOMS", "class_name": "ProjectRoom" }]
      },
      "images": { "binding": "IMAGES" },
      "r2_buckets": [{ "binding": "ASSETS", "bucket_name": "manga-assets-staging" }],
      "vars": {
        // staging の apps/web のオリジンが決まるまではローカルの apps/web から叩く
        "ENVIRONMENT": "staging",
        "WEB_ORIGINS": "http://localhost:5173",
        "MONTHLY_GENERATION_LIMIT": "300"
      }
    }
  }
}
