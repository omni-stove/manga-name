{
  "name": "manga-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "manga-api",
      "database_id": "local",
      "migrations_dir": "migrations"
    }
  ]
  // 秘密: wrangler secret put APP_ACCESS_TOKEN（実プロバイダを足すときはその API キーも）
}
